{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Next-OlonJS  Template Documentation",
  "theme": "luma",
  "colors": {
    "primary": "#7c7c7c",
    "light": "#fafafa",
    "dark": "#cdcdcd"
  },
  "favicon": {
    "light": "https://media.brand.dev/21a6171c-cdfe-48e3-bd45-09d200a98b6a.png",
    "dark": "/images/favicon.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/olonjs/next-dev-portfolio"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "deploy-to-vercel"
            ]
          },
          {
            "group": "Content",
            "pages": [
              "content/pages",
              "content/blog-posts",
              "content/projects",
              "content/site-config"
            ]
          },
          {
            "group": "Studio",
            "pages": [
              "studio/overview",
              "studio/editing",
              "studio/assets"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "customization/theme",
              "customization/navigation",
              "customization/sections"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "advanced/mcp-manifests",
              "advanced/environment-variables",
              "advanced/schema-validation"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog/2026-08-14-launch"
            ]
          }
        ]
      }
    ]
  },
  "markdown": {
    "schema": true
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#050505"
    },
    "decoration": "grid"
  },
  "logo": {
    "light": "/images/Senzatitolo-14agosto2026alleore16.27.53(3).png",
    "dark": "/images/Senzatitolo-14agosto2026alleore16.27.53(2).png",
    "href": "https://www.olonjs.com"
  },
  "contextual": {
    "options": [
      "claude",
      "chatgpt",
      "aistudio",
      "cursor",
      "mcp"
    ],
    "display": "header"
  },
  "icons": {
    "library": "tabler"
  },
  "appearance": {
    "default": "dark"
  }
}
